{
  "name": "harborline",
  "version": "1.0.0",
  "private": true,
  "description": "Harborline: ship docking and port tycoon game",
  "scripts": {
    "add:android": "npx cap add android && node scripts/landscape.mjs",
    "add:ios": "npx cap add ios && node scripts/landscape.mjs",
    "icons": "npx capacitor-assets generate --iconBackgroundColor \"#143048\" --splashBackgroundColor \"#08131d\" --splashBackgroundColorDark \"#08131d\"",
    "sync": "npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "preview": "npx --yes http-server www -p 8080 -c-1",
    "icons:android": "npx capacitor-assets generate --android --iconBackgroundColor \"#143048\" --splashBackgroundColor \"#08131d\" --splashBackgroundColorDark \"#08131d\"",
    "release:android": "node scripts/android-release.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/assets": "^3.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}